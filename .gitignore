# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# User runtime data, cookies, and local state (CRITICAL: prevents leaking user sessions, anchors, and local paths)
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
cookies.txt
download_archive.txt
*.tmp

# Test, coverage, and cache artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Windows shell shortcuts (binary files contain machine-specific absolute user paths)
*.lnk

# Environment variables & local secrets
.env
.env.*
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Download output & media files (if user downloads into workspace)
*.mp4
*.mkv
*.webm
*.part
*.ytdl
